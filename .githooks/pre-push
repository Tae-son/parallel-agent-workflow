#!/bin/sh
# pre-push: block any push whose destination is refs/heads/main. Enable once per clone with
#   git config core.hooksPath .githooks
# Local safety rail, not a security boundary: another clone can omit it.
set -eu

if [ "${ALLOW_MAIN_PUSH:-0}" = "1" ]; then
  printf '%s\n' 'WARNING: emergency override enabled (ALLOW_MAIN_PUSH=1); allowing push to main.' >&2
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    printf '%s\n' "ERROR: push to refs/heads/main blocked (source: $local_ref)." >&2
    printf '%s\n' 'Push a feature branch and merge it through a reviewed pull request.' >&2
    printf '%s\n' 'Emergency only: repeat with ALLOW_MAIN_PUSH=1.' >&2
    blocked=1
  fi
done

exit "$blocked"
